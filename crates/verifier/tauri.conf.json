{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Integrity Verifier",
  "version": "0.1.0",
  "identifier": "com.fileintegrity.verifier",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "File Integrity Verifier",
        "width": 1000,
        "height": 650,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
